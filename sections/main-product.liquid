            <span class="text-on-surface font-bold">Hamza M.</span>
            <span class="text-primary font-semibold">Verified Buyer</span>
          </div>
        </div>

        <div class="bg-surface-container-low p-space-md rounded-xl border border-outline-variant/30 flex flex-col justify-between">
          <div class="space-y-space-2xs">
            <div class="flex items-center text-primary-container">
              {% for i in (1..5) %}
                <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
              {% endfor %}
            </div>
            <div class="font-serif font-bold text-on-surface text-base">Best gourmand in my wardrobe</div>
            <p class="font-body-md text-xs text-on-surface-variant leading-relaxed">"Upgraded to the 100ml grand flacon after testing the 10ml travel roll-on. The balance of floral orange blossom prevents it from feeling cloying. True artisan craft."</p>
          </div>
          <div class="mt-space-md pt-space-xs border-t border-outline-variant/30 flex items-center justify-between font-label-caps text-[10px] text-outline">
            <span class="text-on-surface font-bold">Sana Z.</span>
            <span class="text-primary font-semibold">Verified Buyer</span>
          </div>
        </div>
      </div>
    </div>
