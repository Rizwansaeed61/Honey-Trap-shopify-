{% if section.settings.show_announcement %}
  <div class="py-space-xs px-gutter text-center font-label-caps tracking-[0.2em] flex items-center justify-center gap-space-xs border-b border-primary-container/30 text-xs" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    {% if section.settings.icon != blank %}
      <span class="material-symbols-outlined text-[15px] text-primary-fixed">{{ section.settings.icon }}</span>
    {% endif %}
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="hover:underline transition-all">
        {{ section.settings.text }}
      </a>
    {% else %}
      <span>{{ section.settings.text }}</span>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Complimentary Signature Discovery Vial on All Extrait de Parfum Orders | Handcrafted French Oils"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement Link"
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Material Icon Name",
      "default": "auto_awesome",
      "info": "e.g. auto_awesome, local_shipping, redeem, verified"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#845400"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
