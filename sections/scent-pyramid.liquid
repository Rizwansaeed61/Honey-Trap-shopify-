<section class="py-space-2xl bg-surface-container-low border-y border-outline-variant/30" id="notes-pyramid">
  <div class="max-w-7xl mx-auto px-gutter">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-center">
      <!-- Left: Sensory Pyramid Description -->
      <div class="lg:col-span-6 space-y-space-md">
        <div class="inline-flex items-center gap-space-xs bg-primary-fixed/50 text-on-primary-fixed border border-primary-container/30 px-space-sm py-space-2xs rounded-full">
          <span class="material-symbols-outlined text-[16px] text-primary">local_florist</span>
          <span class="font-label-caps text-xs tracking-wider">OLFACTORY PYRAMID</span>
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl text-primary font-semibold">Anatomy of 'Honey Trap'</h2>
        <p class="font-body-lg text-on-surface-variant leading-relaxed text-sm sm:text-base">
          Crafted for connoisseurs of edible opulence. The fragrance evolves across 12 hours like liquid honey crystallizing into warm amber and cocoa silk.
        </p>

        <div class="space-y-space-sm pt-space-xs">
          <!-- Top Notes -->
          <div class="flex items-start gap-space-sm bg-surface-container-lowest p-space-sm rounded-lg shadow-xs border border-outline-variant/40">
            <div class="w-10 h-10 rounded-full bg-primary-fixed/60 flex items-center justify-center text-primary font-serif font-bold text-sm flex-shrink-0">01</div>
            <div>
              <div class="font-serif font-semibold text-on-surface text-base">Top Notes: The Golden Opening</div>
              <div class="font-body-md text-on-surface-variant text-xs mt-0.5">Bitter Orange Blossom, Candied Ginger, Glazed Golden Wild Honey</div>
            </div>
          </div>
          <!-- Heart Notes -->
          <div class="flex items-start gap-space-sm bg-surface-container-lowest p-space-sm rounded-lg shadow-xs border border-outline-variant/40">
            <div class="w-10 h-10 rounded-full bg-primary-container/20 flex items-center justify-center text-primary font-serif font-bold text-sm flex-shrink-0">02</div>
            <div>
              <div class="font-serif font-semibold text-on-surface text-base">Heart Notes: The Gourmand Soul</div>
              <div class="font-body-md text-on-surface-variant text-xs mt-0.5">Dark Chocolate Truffle, Ceylon Cinnamon Quill, Roasted Tonka Bean</div>
            </div>
          </div>
          <!-- Base Notes -->
          <div class="flex items-start gap-space-sm bg-surface-container-lowest p-space-sm rounded-lg shadow-xs border border-outline-variant/40">
            <div class="w-10 h-10 rounded-full bg-secondary-fixed flex items-center justify-center text-secondary font-serif font-bold text-sm flex-shrink-0">03</div>
            <div>
              <div class="font-serif font-semibold text-on-surface text-base">Base Notes: The Lasting Sillage</div>
              <div class="font-body-md text-on-surface-variant text-xs mt-0.5">Warm Amber Resin, Bourbon Vanilla Pod, Aged Patchouli &amp; Sandalwood</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Interactive Fragrance Discovery & Layering Box -->
      <div class="lg:col-span-6 bg-surface-container-lowest p-space-lg rounded-xl shadow-lg border border-outline-variant/60 space-y-space-md" id="regimen">
        <div class="flex items-center justify-between pb-space-xs border-b border-outline-variant/30">
          <div>
            <div class="font-serif font-bold text-primary text-xl">The Golden Trio Discovery Bundle</div>
            <div class="font-body-md text-xs text-on-surface-variant">Signature Gourmand Layering Trio</div>
          </div>
          <span class="font-label-caps text-xs text-primary bg-primary-fixed px-space-xs py-1 rounded-full uppercase tracking-wider font-semibold">Save Rs. 750</span>
        </div>

        <!-- Step Item 1 -->
        <div class="routine-card flex items-center justify-between gap-space-sm p-space-sm bg-surface-container-low rounded-lg transition-all border border-outline-variant/30">
          <div class="flex items-center gap-space-sm">
            <div class="w-14 h-14 bg-surface-container-lowest rounded-md flex items-center justify-center p-1 border border-outline-variant/40 flex-shrink-0">
              <img alt="Honey Trap thumbnail" class="h-full object-contain" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAYgsab-Y14NBhqCbuiWICPtXRTEMZlP1VUOWIdzqQVW7PD9o1ykVgIGAVicBFvwDoRQYFY3EhUgGe-cpfRLpsYfxd5X5k5YyorkNjCk0ykqed6QQUrV2r_1699HXXmY3IZCZwgtE7umdkEJQj9knDyT7LmkztFHeEI-UwL40KxnMWi-EEFn-qKXx5WEbmisLI8OpcX78_XtIGL-o9KUu_EZiHsfO8yP51P_4gMr86BkvV2o8MaqUDRhR1WYRJtGAoGMn0"/>
            </div>
            <div>
              <div class="flex items-center gap-space-xs mb-1">
                <span class="bg-primary text-on-primary font-label-caps text-[9px] px-space-xs py-0.5 rounded">HERO</span>
                <span class="bg-surface-container-high font-label-caps text-[9px] text-tertiary px-space-xs py-0.5 rounded">Warm Honey</span>
              </div>
              <div class="font-serif font-bold text-on-surface text-sm">Honey Trap (50ml)</div>
              <div class="font-body-md text-on-surface-variant text-xs hidden sm:block">Extrait de parfum — 35% concentration</div>
            </div>
          </div>
          <div class="flex items-center gap-space-sm">
            <span class="font-serif font-bold text-primary text-base">Rs. 2,450</span>
            <label class="cursor-pointer">
              <input checked="" class="routine-check w-5 h-5 accent-primary cursor-pointer" data-price="2450" onchange="calculateRoutineTotal()" type="checkbox"/>
            </label>
          </div>
        </div>

        <!-- Step Item 2 -->
        <div class="routine-card flex items-center justify-between gap-space-sm p-space-sm bg-surface-container-low rounded-lg transition-all border border-outline-variant/30">
          <div class="flex items-center gap-space-sm">
            <div class="w-14 h-14 bg-surface-container-lowest rounded-md flex items-center justify-center p-1 border border-outline-variant/40 flex-shrink-0">
              <img alt="Bourbon Amber Oil thumbnail" class="h-full object-contain" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDB4tP6V2H0M6-l58AVFar3fFITgUR1leXzccrNffz6Nkn9fO2C63nCDR7XZ5f8yeuI3zmh7JUOEDQ5v9Fjl8I9CDyxTTDYiL_J2LGvQn0GGPBDJ19eCeQ0ENOtGS-JuoXCbgbb8FfXtd9bmYtoF5ckaYRw3cDpaKVx-VHvaGmTBja20YU-02Wj2nj14OcoGXKTEeStILHYkMAPiE-ZjgQyNMiwPo56lLTOYrzpTOtY3bACsog7Z90Ipw"/>
            </div>
            <div>
              <div class="flex items-center gap-space-xs mb-1">
                <span class="bg-primary text-on-primary font-label-caps text-[9px] px-space-xs py-0.5 rounded">LAYER 02</span>
                <span class="bg-surface-container-high font-label-caps text-[9px] text-tertiary px-space-xs py-0.5 rounded">Woody Base</span>
              </div>
              <div class="font-serif font-bold text-on-surface text-sm">Bourbon Amber Oil (30ml)</div>
              <div class="font-body-md text-on-surface-variant text-xs hidden sm:block">Intense primer oil for deep base longevity</div>
            </div>
          </div>
          <div class="flex items-center gap-space-sm">
            <span class="font-serif font-bold text-primary text-base">Rs. 950</span>
            <label class="cursor-pointer">
              <input checked="" class="routine-check w-5 h-5 accent-primary cursor-pointer" data-price="950" onchange="calculateRoutineTotal()" type="checkbox"/>
            </label>
          </div>
        </div>

        <!-- Step Item 3 -->
        <div class="routine-card flex items-center justify-between gap-space-sm p-space-sm bg-surface-container-low rounded-lg transition-all border border-outline-variant/30">
          <div class="flex items-center gap-space-sm">
            <div class="w-14 h-14 bg-surface-container-lowest rounded-md flex items-center justify-center p-1 border border-outline-variant/40 flex-shrink-0">
              <img alt="Travel atomizer thumbnail" class="h-full object-contain" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDV16vqAh172qqU0IfKJG14arAeX7UzpkyOfG2xKJ-rdwCQqVV_68aivT0alNDmUM3qvL8RKGlciHXM5CRQaVfIk8kFuqB4d4H2QL21TF-bT9ugb_75-2EvrOaTjWsBrOHTt776UTFPMtRszBnBFzfGvzl5clSETseI6bHu6pq-h6bFFzOY6Wy01lSU5sqLMv2SFmb_GEFjl6eEeMSPITh6su3TUV7-ElQJWhm5xcQrz40YoVm122p0Rw"/>
            </div>
            <div>
              <div class="flex items-center gap-space-xs mb-1">
                <span class="bg-primary text-on-primary font-label-caps text-[9px] px-space-xs py-0.5 rounded">POCKET</span>
                <span class="bg-surface-container-high font-label-caps text-[9px] text-tertiary px-space-xs py-0.5 rounded">Travel Luxury</span>
              </div>
              <div class="font-serif font-bold text-on-surface text-sm">Gold Pocket Atomizer (10ml)</div>
              <div class="font-body-md text-on-surface-variant text-xs hidden sm:block">Refillable machined brass atomizer</div>
            </div>
          </div>
          <div class="flex items-center gap-space-sm">
            <span class="font-serif font-bold text-primary text-base">Rs. 600</span>
            <label class="cursor-pointer">
              <input checked="" class="routine-check w-5 h-5 accent-primary cursor-pointer" data-price="600" onchange="calculateRoutineTotal()" type="checkbox"/>
            </label>
          </div>
        </div>

        <!-- Total Calculation & Add Routine to Bag Button -->
        <div class="pt-space-xs">
          <button class="w-full py-space-sm rounded-full bg-primary text-on-primary font-label-caps text-xs tracking-widest flex items-center justify-center gap-space-sm shadow-md hover:bg-primary-container transition-all" id="bundle-submit-btn" onclick="triggerRoutineAdd()">
            <span class="material-symbols-outlined text-[20px]">loyalty</span>
            <span id="bundle-btn-text">ADD 3 PIECE TRIO TO BAG • Rs. 4,000</span>
          </button>
          <div class="text-center mt-space-xs text-on-surface-variant font-body-md text-xs flex items-center justify-center gap-1">
            <span class="material-symbols-outlined text-[15px] text-primary">redeem</span>
            <span>Includes Free Handcrafted Velvet Travel Pouch</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Scent Pyramid & Trio",
  "presets": [
    {
      "name": "Scent Pyramid & Trio"
    }
  ]
}
{% endschema %}
