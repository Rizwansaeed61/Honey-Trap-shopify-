<section class="py-space-2xl bg-surface-container-low border-y border-outline-variant/30" id="notes-pyramid">
  <div class="max-w-7xl mx-auto px-gutter">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-center">
      <!-- Left: Sensory Pyramid Description -->
      <div class="lg:col-span-6 space-y-space-md">
        {% if section.settings.badge_text != blank %}
          <div class="inline-flex items-center gap-space-xs bg-primary-fixed/50 text-on-primary-fixed border border-primary-container/30 px-space-sm py-space-2xs rounded-full">
            <span class="material-symbols-outlined text-[16px] text-primary">local_florist</span>
            <span class="font-label-caps text-xs tracking-wider">{{ section.settings.badge_text }}</span>
          </div>
        {% endif %}

        <h2 class="font-serif text-3xl sm:text-4xl text-primary font-semibold">{{ section.settings.heading | default: "Anatomy of 'Honey Trap'" }}</h2>
        <p class="font-body-lg text-on-surface-variant leading-relaxed text-sm sm:text-base">
          {{ section.settings.description | default: "Crafted for connoisseurs of edible opulence. The fragrance evolves across 12 hours like liquid honey crystallizing into warm amber and cocoa silk." }}
        </p>

        <div class="space-y-space-sm pt-space-xs">
          <!-- Top Notes -->
          <div class="flex items-start gap-space-sm bg-surface-container-lowest p-space-sm rounded-lg shadow-xs border border-outline-variant/40">
            <div class="w-10 h-10 rounded-full bg-primary-fixed/60 flex items-center justify-center text-primary font-serif font-bold text-sm flex-shrink-0">01</div>
            <div>
              <div class="font-serif font-semibold text-on-surface text-base">{{ section.settings.top_notes_title | default: "Top Notes: The Golden Opening" }}</div>
              <div class="font-body-md text-on-surface-variant text-xs mt-0.5">{{ section.settings.top_notes_desc | default: "Bitter Orange Blossom, Candied Ginger, Glazed Golden Wild Honey" }}</div>
            </div>
          </div>
          <!-- Heart Notes -->
          <div class="flex items-start gap-space-sm bg-surface-container-lowest p-space-sm rounded-lg shadow-xs border border-outline-variant/40">
            <div class="w-10 h-10 rounded-full bg-primary-container/20 flex items-center justify-center text-primary font-serif font-bold text-sm flex-shrink-0">02</div>
            <div>
              <div class="font-serif font-semibold text-on-surface text-base">{{ section.settings.heart_notes_title | default: "Heart Notes: The Gourmand Soul" }}</div>
              <div class="font-body-md text-on-surface-variant text-xs mt-0.5">{{ section.settings.heart_notes_desc | default: "Dark Chocolate Truffle, Ceylon Cinnamon Quill, Roasted Tonka Bean" }}</div>
            </div>
          </div>
          <!-- Base Notes -->
          <div class="flex items-start gap-space-sm bg-surface-container-lowest p-space-sm rounded-lg shadow-xs border border-outline-variant/40">
            <div class="w-10 h-10 rounded-full bg-secondary-fixed flex items-center justify-center text-secondary font-serif font-bold text-sm flex-shrink-0">03</div>
            <div>
              <div class="font-serif font-semibold text-on-surface text-base">{{ section.settings.base_notes_title | default: "Base Notes: The Lasting Sillage" }}</div>
              <div class="font-body-md text-on-surface-variant text-xs mt-0.5">{{ section.settings.base_notes_desc | default: "Warm Amber Resin, Bourbon Vanilla Pod, Aged Patchouli & Sandalwood" }}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Interactive Fragrance Discovery & Layering Box -->
      <div class="lg:col-span-6 bg-surface-container-lowest p-space-lg rounded-xl shadow-lg border border-outline-variant/60 space-y-space-md" id="regimen">
        <div class="flex items-center justify-between pb-space-xs border-b border-outline-variant/30">
          <div>
            <div class="font-serif font-bold text-primary text-xl">{{ section.settings.bundle_title | default: "The Golden Trio Discovery Bundle" }}</div>
            <div class="font-body-md text-xs text-on-surface-variant">{{ section.settings.bundle_subtitle | default: "Signature Gourmand Layering Trio" }}</div>
          </div>
          {% if section.settings.bundle_save_badge != blank %}
            <span class="font-label-caps text-xs text-primary bg-primary-fixed px-space-xs py-1 rounded-full uppercase tracking-wider font-semibold">{{ section.settings.bundle_save_badge }}</span>
          {% endif %}
        </div>

        <div class="space-y-space-xs">
          <!-- Trio Item 1 -->
          <label class="routine-card flex items-center justify-between p-space-sm rounded-lg border border-outline-variant/50 hover:border-primary cursor-pointer transition-colors bg-surface-container-low/50">
            <div class="flex items-center gap-space-sm">
              <input checked class="routine-check rounded text-primary focus:ring-primary w-4 h-4" data-price="{{ section.settings.item_1_price | default: 2450 }}" onchange="calculateRoutineTotal()" type="checkbox"/>
              <div>
                <div class="font-serif font-semibold text-on-surface text-sm">{{ section.settings.item_1_title | default: "Honey Trap Extrait" }}</div>
                <div class="font-body-md text-[11px] text-on-surface-variant">{{ section.settings.item_1_notes | default: "Golden Honey & Spiced Cocoa • 50ml" }}</div>
              </div>
            </div>
            <div class="text-right">
              <span class="font-serif font-bold text-primary text-sm">Rs. {{ section.settings.item_1_price | default: 2450 }}</span>
            </div>
          </label>

          <!-- Trio Item 2 -->
          <label class="routine-card flex items-center justify-between p-space-sm rounded-lg border border-outline-variant/50 hover:border-primary cursor-pointer transition-colors bg-surface-container-low/50">
            <div class="flex items-center gap-space-sm">
              <input checked class="routine-check rounded text-primary focus:ring-primary w-4 h-4" data-price="{{ section.settings.item_2_price | default: 2850 }}" onchange="calculateRoutineTotal()" type="checkbox"/>
              <div>
                <div class="font-serif font-semibold text-on-surface text-sm">{{ section.settings.item_2_title | default: "Velvet Vanilla Oud" }}</div>
                <div class="font-body-md text-[11px] text-on-surface-variant">{{ section.settings.item_2_notes | default: "Assam Oud & Vanilla Pod • 50ml" }}</div>
              </div>
            </div>
            <div class="text-right">
              <span class="font-serif font-bold text-primary text-sm">Rs. {{ section.settings.item_2_price | default: 2850 }}</span>
            </div>
          </label>

          <!-- Trio Item 3 -->
          <label class="routine-card flex items-center justify-between p-space-sm rounded-lg border border-outline-variant/50 hover:border-primary cursor-pointer transition-colors bg-surface-container-low/50">
            <div class="flex items-center gap-space-sm">
              <input checked class="routine-check rounded text-primary focus:ring-primary w-4 h-4" data-price="{{ section.settings.item_3_price | default: 2650 }}" onchange="calculateRoutineTotal()" type="checkbox"/>
              <div>
                <div class="font-serif font-semibold text-on-surface text-sm">{{ section.settings.item_3_title | default: "Amber Royale Extrait" }}</div>
                <div class="font-body-md text-[11px] text-on-surface-variant">{{ section.settings.item_3_notes | default: "Warm Labdanum & Tonka • 50ml" }}</div>
              </div>
            </div>
            <div class="text-right">
              <span class="font-serif font-bold text-primary text-sm">Rs. {{ section.settings.item_3_price | default: 2650 }}</span>
            </div>
          </label>
        </div>

        <div class="pt-space-xs space-y-space-xs">
          <button class="w-full py-space-sm rounded-full bg-primary text-on-primary font-label-caps text-xs tracking-[0.16em] uppercase hover:bg-primary-container transition-all shadow-md flex items-center justify-center gap-space-xs" id="bundle-submit-btn" onclick="triggerRoutineAdd()">
            <span class="material-symbols-outlined text-[18px]">shopping_bag</span>
            <span id="bundle-btn-text">ADD 3 ITEMS TO BAG • Rs. 7,950</span>
          </button>
          {% if section.settings.bundle_footer_note != blank %}
            <div class="flex items-center justify-center gap-1 font-body-md text-[11px] text-tertiary">
              <span class="material-symbols-outlined text-[15px] text-primary">redeem</span>
              <span>{{ section.settings.bundle_footer_note }}</span>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

