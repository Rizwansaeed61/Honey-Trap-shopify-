<div class="max-w-7xl mx-auto px-gutter py-space-xl w-full">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start">
    <!-- Left Sidebar Filters -->
    <aside class="lg:col-span-3 flex flex-col gap-space-lg sticky top-40">
      <div class="bg-surface-container-lowest p-space-lg rounded border border-outline-variant/40 shadow-sm flex flex-col gap-space-lg">
        <div class="flex items-center justify-between border-b border-outline-variant/30 pb-space-sm">
          <span class="font-serif text-lg text-primary font-semibold">Refine Scent</span>
          <button class="font-label-caps text-xs text-secondary uppercase tracking-widest hover:underline font-bold">Reset</button>
        </div>

        <!-- Filter Section 1: Scent Family -->
        <div class="flex flex-col gap-space-xs">
          <h4 class="font-label-caps text-xs text-primary uppercase tracking-widest font-bold">Scent Family</h4>
          <div class="flex flex-col gap-2 pt-1 font-body-md text-xs">
            <label class="flex items-center gap-space-xs cursor-pointer group">
              <input checked="" class="w-4 h-4 rounded text-primary accent-primary focus:ring-0 cursor-pointer" type="checkbox"/>
              <span class="text-on-surface group-hover:text-primary">Gourmand &amp; Sweet</span>
              <span class="ml-auto font-label-caps text-[10px] text-outline">8</span>
            </label>
            <label class="flex items-center gap-space-xs cursor-pointer group">
              <input checked="" class="w-4 h-4 rounded text-primary accent-primary focus:ring-0 cursor-pointer" type="checkbox"/>
              <span class="text-on-surface group-hover:text-primary">Floral Amber</span>
              <span class="ml-auto font-label-caps text-[10px] text-outline">6</span>
            </label>
            <label class="flex items-center gap-space-xs cursor-pointer group">
              <input class="w-4 h-4 rounded text-primary accent-primary focus:ring-0 cursor-pointer" type="checkbox"/>
              <span class="text-on-surface group-hover:text-primary">Warm Spices</span>
              <span class="ml-auto font-label-caps text-[10px] text-outline">5</span>
            </label>
            <label class="flex items-center gap-space-xs cursor-pointer group">
              <input class="w-4 h-4 rounded text-primary accent-primary focus:ring-0 cursor-pointer" type="checkbox"/>
              <span class="text-on-surface group-hover:text-primary">Woody Oud</span>
              <span class="ml-auto font-label-caps text-[10px] text-outline">4</span>
            </label>
          </div>
        </div>

        <!-- Filter Section 2: Key Notes -->
        <div class="flex flex-col gap-space-xs">
          <h4 class="font-label-caps text-xs text-primary uppercase tracking-widest font-bold">Key Scent Notes</h4>
          <div class="flex flex-wrap gap-1.5 pt-1">
            <span class="bg-primary text-on-primary font-label-caps text-[11px] px-2.5 py-1 rounded cursor-pointer transition-colors uppercase tracking-wider">Honey</span>
            <span class="bg-surface-container-low text-on-surface hover:bg-primary hover:text-on-primary font-label-caps text-[11px] px-2.5 py-1 rounded cursor-pointer transition-colors border border-outline-variant/30 uppercase tracking-wider">Cinnamon</span>
            <span class="bg-surface-container-low text-on-surface hover:bg-primary hover:text-on-primary font-label-caps text-[11px] px-2.5 py-1 rounded cursor-pointer transition-colors border border-outline-variant/30 uppercase tracking-wider">Orange Blossom</span>
            <span class="bg-surface-container-low text-on-surface hover:bg-primary hover:text-on-primary font-label-caps text-[11px] px-2.5 py-1 rounded cursor-pointer transition-colors border border-outline-variant/30 uppercase tracking-wider">Vanilla Bourbon</span>
            <span class="bg-surface-container-low text-on-surface hover:bg-primary hover:text-on-primary font-label-caps text-[11px] px-2.5 py-1 rounded cursor-pointer transition-colors border border-outline-variant/30 uppercase tracking-wider">Amber Resin</span>
          </div>
        </div>

        <!-- Filter Section 3: Concentration -->
        <div class="flex flex-col gap-space-xs">
          <h4 class="font-label-caps text-xs text-primary uppercase tracking-widest font-bold">Concentration</h4>
          <div class="flex flex-col gap-2 pt-1 font-body-md text-xs">
            <label class="flex items-center gap-space-xs cursor-pointer group">
              <input checked="" class="w-4 h-4 rounded text-primary accent-primary focus:ring-0 cursor-pointer" type="checkbox"/>
              <span class="text-on-surface group-hover:text-primary">Extrait de Parfum (35% Oil)</span>
              <span class="ml-auto font-label-caps text-[10px] text-outline">12</span>
            </label>
            <label class="flex items-center gap-space-xs cursor-pointer group">
              <input checked="" class="w-4 h-4 rounded text-primary accent-primary focus:ring-0 cursor-pointer" type="checkbox"/>
              <span class="text-on-surface group-hover:text-primary">Eau de Parfum (EDP)</span>
              <span class="ml-auto font-label-caps text-[10px] text-outline">8</span>
            </label>
          </div>
        </div>

        <!-- Filter Section 4: Price Range Slider -->
        <div class="flex flex-col gap-space-xs">
          <div class="flex items-center justify-between">
            <h4 class="font-label-caps text-xs text-primary uppercase tracking-widest font-bold">Price Range</h4>
            <span class="font-label-caps text-xs text-primary font-bold">Rs. 1,450 - Rs. 4,950</span>
          </div>
          <div class="pt-2">
            <input class="w-full accent-primary bg-surface-container-high rounded cursor-pointer" max="5000" min="1200" type="range" value="3800"/>
            <div class="flex justify-between font-label-caps text-[10px] text-outline pt-1">
              <span>Rs. 1,200</span>
              <span>Rs. 5,000</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Perfumer Custom Consultation Box -->
      <div class="bg-gradient-to-br from-primary via-on-primary-container to-primary text-on-primary p-space-md rounded border border-primary-container/40 shadow-md flex flex-col gap-space-xs relative overflow-hidden">
        <span class="material-symbols-outlined text-[30px] text-primary-fixed">psychiatry</span>
        <h4 class="font-serif font-bold text-base">Scent Styling Concierge</h4>
        <p class="font-body-md text-xs text-primary-fixed leading-relaxed">Let our Master Nose curate a signature olfactory wardrobe tailored to your skin chemistry.</p>
        <a class="mt-2 inline-flex items-center justify-center font-label-caps text-xs uppercase tracking-widest bg-secondary-container text-on-secondary-container font-bold px-space-md py-2 rounded hover:bg-secondary-fixed transition-colors" href="#quiz">
          Consult Fragrance Nose
