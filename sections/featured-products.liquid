                <span class="font-serif text-base font-bold text-primary">Rs. 2,450</span>
                <span class="font-body-md text-[11px] text-outline line-through ml-1">Rs. 2,950</span>
              </div>
              <button onclick="window.luxuryCart.addItem({id: 'honey-trap-50ml', title: 'Honey Trap', presentation: '50ml EDP', price: 2450, quantity: 1})" class="px-space-md py-space-2xs rounded-full bg-primary text-on-primary font-label-caps text-[11px] uppercase tracking-wider hover:bg-primary-container transition-colors flex items-center gap-1 shadow-sm">
                <span class="material-symbols-outlined text-[15px]">add_shopping_cart</span>
                <span>ADD</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Product 2: Velvet Vanilla Oud -->
