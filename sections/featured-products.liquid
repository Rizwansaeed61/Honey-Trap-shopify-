<section class="py-space-2xl bg-surface" id="signature-honey-trap">
  <div class="max-w-7xl mx-auto px-gutter space-y-space-xl">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-sm border-b border-outline-variant/40 pb-space-md">
      <div>
        <div class="font-label-caps uppercase tracking-[0.2em] text-primary flex items-center gap-1 text-xs">
          <span class="material-symbols-outlined text-[16px] text-primary">auto_awesome</span>
          {{ section.settings.subtitle | default: "Artisanal Extrait Collection" }}
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl text-on-surface mt-1 font-semibold">{{ section.settings.title | default: "Signature Perfumes" }}</h2>
      </div>
      <p class="font-body-md text-on-surface-variant max-w-md text-xs sm:text-sm leading-relaxed">
        {{ section.settings.description | default: "Meticulously aged with up to 35% pure perfume oils imported directly from Grasse, France. Designed to linger and command attention." }}
      </p>
    </div>

    <!-- Products Grid -->
    {% assign col_class = "lg:grid-cols-4" %}
    {% if section.settings.columns_desktop == 2 %}
      {% assign col_class = "lg:grid-cols-2" %}
    {% elsif section.settings.columns_desktop == 3 %}
      {% assign col_class = "lg:grid-cols-3" %}
    {% endif %}

    <div class="grid grid-cols-1 sm:grid-cols-2 {{ col_class }} gap-space-lg" id="product-card-grid">
      {% if section.settings.collection != blank and section.settings.collection.products.size > 0 %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          <div class="product-item flex flex-col bg-surface-container-lowest rounded-xl p-space-md shadow-md hover:shadow-2xl border border-outline-variant/40 hover:border-primary-container/60 transition-all duration-300 relative group">
            <div class="flex items-center justify-between gap-space-xs mb-space-xs">
              <span class="bg-primary text-on-primary font-label-caps text-[9px] px-space-xs py-0.5 rounded-full uppercase tracking-wider">
                {% if product.tags contains 'bestseller' or forloop.first %}Signature Bestseller{% else %}35% Extrait{% endif %}
              </span>
              <button class="text-outline hover:text-primary transition-colors" title="Save to wishlist">
                <span class="material-symbols-outlined text-[20px]">favorite</span>
              </button>
            </div>

            <a href="{{ product.url }}" class="h-60 w-full bg-gradient-to-b from-surface-bright to-surface-container-low rounded-lg overflow-hidden flex items-center justify-center relative p-space-xs mb-space-sm border border-outline-variant/30 block">
              {% if product.featured_image != blank %}
                <img alt="{{ product.title | escape }}" class="h-full object-contain transform group-hover:scale-105 transition-transform duration-300" src="{{ product.featured_image | image_url: width: 500 }}"/>
              {% else %}
                <img alt="{{ product.title | escape }}" class="h-full object-contain transform group-hover:scale-105 transition-transform duration-300" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCFbjeLEsSMrk90Nxs3degWda54RyyjHUj6aYb8FIpZli2h1oqWobfxgrZOwLpQAfBwKq_VEJvW5h5tokGoNuwsNh1d8kdLsxvRCr3Zftgpt1IoScxQYrCjl7SY282nqrIKmOq4-Pf7ja93ZfJTIIw9cWnzzpcbX_yla7hLIYxGi67zAdljfsZG_81g2b8paOr-5CRL6EESCXnEA7KpZ0uYqYcjVSnJO76crBOgCgxxsLqeOtrkB3tO1CO2gUloNSTQqZg"/>
              {% endif %}
              <span class="absolute bottom-2 left-2 bg-surface-container-lowest/90 px-space-xs py-0.5 rounded font-label-caps text-[10px] text-primary border border-outline-variant/40 uppercase tracking-wider">{{ product.type | default: "Extrait de Parfum" }}</span>
            </a>

            <div class="flex-1 flex flex-col">
              <div class="flex items-center gap-1 text-primary mb-1">
                <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="font-label-caps text-xs text-on-surface font-semibold">4.9</span>
                <span class="font-body-md text-on-surface-variant text-xs">(800+ reviews)</span>
              </div>
              <a href="{{ product.url }}" class="font-serif text-on-surface mb-1 text-lg font-bold hover:text-primary transition-colors">{{ product.title }}</a>
              <p class="font-body-md text-on-surface-variant line-clamp-2 mb-space-xs text-xs">
                {{ product.description | strip_html | truncate: 110 }}
              </p>

              <!-- Size selector -->
              <div class="flex items-center gap-1 py-1 mb-2">
                {% for variant in product.variants limit: 3 %}
                  <button class="size-btn px-2 py-0.5 rounded text-[10px] font-label-caps border {% if forloop.first %}bg-surface-container-high text-primary border-primary/40 active{% else %}bg-surface-container-low text-on-surface-variant border-outline-variant/50{% endif %}" onclick="selectProductSize(this, '{{ variant.price | money_without_currency | remove: ',' }}', '{{ variant.title }}')">
                    {{ variant.title }}
                  </button>
                {% endfor %}
              </div>

              <div class="mt-auto pt-space-xs border-t border-outline-variant/30 flex items-center justify-between">
                <div>
                  <span class="font-serif text-base font-bold text-primary">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="font-body-md text-[11px] text-outline line-through ml-1">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </div>
                <button onclick="window.luxuryCart.addItem({id: '{{ product.variants.first.id | default: product.handle }}', title: '{{ product.title | escape }}', presentation: '50ml EDP', price: {{ product.price | money_without_currency | remove: ',' | default: 2450 }}, quantity: 1})" class="px-space-md py-space-2xs rounded-full bg-primary text-on-primary font-label-caps text-[11px] uppercase tracking-wider hover:bg-primary-container transition-colors flex items-center gap-1 shadow-sm">
                  <span class="material-symbols-outlined text-[15px]">add_shopping_cart</span>
                  <span>ADD</span>
                </button>
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Curated 4 Luxury Fragrances -->
        <!-- Product 1: Honey Trap (Hero Flagship) -->
        <div class="product-item flex flex-col bg-surface-container-lowest rounded-xl p-space-md shadow-md hover:shadow-2xl border border-primary-container/40 transition-all duration-300 relative group" data-concerns="gourmand amber">
          <div class="flex items-center justify-between gap-space-xs mb-space-xs">
            <div class="flex flex-wrap gap-1">
              <span class="bg-primary text-on-primary font-label-caps text-[9px] px-space-xs py-0.5 rounded-full uppercase tracking-wider">Signature Bestseller</span>
              <span class="bg-primary-fixed text-on-primary-fixed font-label-caps text-[9px] px-space-xs py-0.5 rounded-full uppercase tracking-wider">12h+ Sillage</span>
            </div>
            <button class="text-outline hover:text-primary transition-colors" title="Save to wishlist">
              <span class="material-symbols-outlined text-[20px]">favorite</span>
            </button>
          </div>

          <a href="{{ routes.all_products_collection_url }}" class="h-60 w-full bg-gradient-to-b from-surface-bright to-surface-container-low rounded-lg overflow-hidden flex items-center justify-center relative p-space-xs mb-space-sm border border-outline-variant/30 block">
            <img alt="Honey Trap Extrait De Parfum bottle" class="h-full object-contain transform group-hover:scale-105 transition-transform duration-300" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCFbjeLEsSMrk90Nxs3degWda54RyyjHUj6aYb8FIpZli2h1oqWobfxgrZOwLpQAfBwKq_VEJvW5h5tokGoNuwsNh1d8kdLsxvRCr3Zftgpt1IoScxQYrCjl7SY282nqrIKmOq4-Pf7ja93ZfJTIIw9cWnzzpcbX_yla7hLIYxGi67zAdljfsZG_81g2b8paOr-5CRL6EESCXnEA7KpZ0uYqYcjVSnJO76crBOgCgxxsLqeOtrkB3tO1CO2gUloNSTQqZg"/>
            <span class="absolute bottom-2 left-2 bg-surface-container-lowest/90 px-space-xs py-0.5 rounded font-label-caps text-[10px] text-primary border border-outline-variant/40 uppercase tracking-wider">Extrait de Parfum</span>
          </a>

          <div class="flex-1 flex flex-col">
            <div class="flex items-center gap-1 text-primary mb-1">
              <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="font-label-caps text-xs text-on-surface font-semibold">4.9</span>
              <span class="font-body-md text-on-surface-variant text-xs">(840 reviews)</span>
            </div>
            <a href="{{ routes.all_products_collection_url }}" class="font-serif text-on-surface mb-1 text-lg font-bold hover:text-primary transition-colors">Honey Trap</a>
            <p class="font-body-md text-on-surface-variant line-clamp-2 mb-space-xs text-xs">
              Raw Wild Honey, Spiced Cocoa Truffle, Orange Blossom &amp; Bourbon Vanilla. Warm, intoxicating, and memorable.
            </p>

            <div class="flex items-center gap-1 py-1 mb-2">
              <button class="size-btn active px-2 py-0.5 rounded text-[10px] font-label-caps bg-surface-container-high text-primary border border-primary/40" onclick="selectProductSize(this, 2450, '50ml')">50ml</button>
              <button class="size-btn px-2 py-0.5 rounded text-[10px] font-label-caps bg-surface-container-low text-on-surface-variant border border-outline-variant/50" onclick="selectProductSize(this, 3950, '100ml')">100ml</button>
