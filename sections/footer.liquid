    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Menu 1 Title",
      "default": "Fragrances"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1 Link List"
    },
    {
      "type": "text",
      "id": "menu_2_title",
