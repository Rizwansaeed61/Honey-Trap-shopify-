      "label": "Trust Item 2 Icon",
      "default": "verified"
    },
    {
      "type": "text",
      "id": "trust_2_title",
      "label": "Trust Item 2 Title",
      "default": "Authenticity Certified"
    },
    {
      "type": "text",
      "id": "trust_2_desc",
      "label": "Trust Item 2 Subtitle",
      "default": "Original French Grasse essences"
    },
    {
      "type": "text",
      "id": "trust_3_icon",
      "label": "Trust Item 3 Icon",
      "default": "redeem"
    },
    {
      "type": "text",
      "id": "trust_3_title",
      "label": "Trust Item 3 Title",
      "default": "Free Scent Vial"
    },
    {
      "type": "text",
      "id": "trust_3_desc",
      "label": "Trust Item 3 Subtitle",
      "default": "Included with every purchase"
    },
    {
      "type": "text",
      "id": "trust_4_icon",
      "label": "Trust Item 4 Icon",
      "default": "lock_reset"
    },
    {
      "type": "text",
      "id": "trust_4_title",
      "label": "Trust Item 4 Title",
      "default": "Scent Guarantee"
    },
    {
      "type": "text",
      "id": "trust_4_desc",
      "label": "Trust Item 4 Subtitle",
      "default": "Exchange if not deeply loved"
    },
    {
      "type": "header",
      "content": "Brand Identity & Gazette"
    },
    {
