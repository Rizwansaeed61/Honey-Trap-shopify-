{% if section.settings.enable_sticky_atc %}
  <div 
    id="sticky-mobile-atc" 
    class="fixed bottom-0 left-0 right-0 z-40 bg-surface-bright/95 backdrop-blur-md border-t border-outline-variant/40 py-2.5 px-4 shadow-[0_-4px_20px_rgba(0,0,0,0.12)] transform translate-y-full opacity-0 transition-all duration-300 pointer-events-none {% if section.settings.show_desktop %}flex{% else %}flex md:hidden{% endif %} items-center justify-between gap-3"
  >
    <div class="flex items-center gap-2.5 min-w-0">
      {% if product.featured_image %}
        <img 
          src="{{ product.featured_image | image_url: width: 120 }}" 
          alt="{{ product.title | escape }}" 
          class="w-10 h-10 object-contain rounded-lg bg-surface-container-low border border-outline-variant/30 flex-shrink-0"
          loading="lazy"
          width="40"
          height="40"
        >
      {% else %}
        <div class="w-10 h-10 rounded-lg bg-surface-container-low border border-outline-variant/30 flex items-center justify-center text-primary flex-shrink-0">
          <span class="material-symbols-outlined text-[20px]">local_florist</span>
        </div>
      {% endif %}
      <div class="flex flex-col min-w-0">
        <span class="font-serif text-on-surface font-semibold text-xs truncate max-w-[140px] sm:max-w-[200px]">{{ product.title | default: "Honey Trap" }}</span>
        <span class="font-serif text-primary font-bold text-xs" id="sticky-atc-price">{{ product.selected_or_first_available_variant.price | default: 245000 | money }}</span>
      </div>
    </div>

    <button 
      type="button" 
      class="flex-1 max-w-[190px] py-2 px-3 rounded-full text-on-primary font-label-caps tracking-wider text-[11px] font-bold text-center shadow-md active:scale-95 transition-all flex items-center justify-center gap-1.5 uppercase cursor-pointer"
      style="background: linear-gradient(90deg, #845400 0%, #c98a2c 60%, #904c21 100%);"
      onclick="submitMainProductForm()"
      id="sticky-atc-submit"
    >
      <span class="material-symbols-outlined text-[16px]">shopping_bag</span>
      <span>{{ section.settings.button_text | default: "Add to Bag" }}</span>
    </button>
  </div>

  <script>
    function submitMainProductForm() {
      const mainForm = document.getElementById('main-product-form');
      if (mainForm) {
        // Trigger submit
        const submitBtn = mainForm.querySelector('button[type="submit"]');
        if (submitBtn) {
          submitBtn.click();
        } else {
          mainForm.submit();
        }
      } else {
        // Fallback AJAX add to cart
        const variantId = document.getElementById('selected-variant-id')?.value || '{{ product.selected_or_first_available_variant.id }}';
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
        }).then(res => {
          if (res.ok) {
            if (window.theme && typeof window.theme.openCartDrawer === 'function') {
              window.theme.openCartDrawer();
            } else {
              window.location.href = '/cart';
            }
          }
        });
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const stickyBar = document.getElementById('sticky-mobile-atc');
      const mainBtn = document.getElementById('main-atc-button');
      if (!stickyBar) return;

      if (mainBtn) {
        const observer = new IntersectionObserver(([entry]) => {
          if (!entry.isIntersecting) {
            stickyBar.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
            stickyBar.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
          } else {
            stickyBar.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
            stickyBar.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
          }
        }, { threshold: 0.1 });
        observer.observe(mainBtn);
      } else {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 400) {
            stickyBar.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
            stickyBar.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
          } else {
            stickyBar.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
            stickyBar.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
          }
        });
      }
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "Sticky Mobile ATC",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_atc",
      "label": "Enable Sticky ATC Bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on Desktop as well",
      "default": false
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add to Bag"
    }
  ],
  "presets": [
    {
      "name": "Sticky Mobile ATC"
    }
  ]
}
{% endschema %}
