{{ 'theme.css' | asset_url | stylesheet_tag }}

<div class="max-w-7xl mx-auto px-gutter py-space-md w-full">
  <!-- 1. Breadcrumbs & Fragrance Profile Badges -->
  <div class="flex flex-wrap items-center justify-between gap-space-sm mb-space-lg">
    <nav class="flex items-center gap-space-xs font-body-md text-xs text-on-surface-variant">
      <a class="hover:text-primary transition-colors" href="{{ routes.root_url }}">Home</a>
      <span class="material-symbols-outlined text-[13px] text-outline">chevron_right</span>
      <a class="hover:text-primary transition-colors" href="{{ routes.all_products_collection_url }}">Catalog</a>
      <span class="material-symbols-outlined text-[13px] text-outline">chevron_right</span>
      <span class="text-primary font-semibold truncate max-w-[200px]">{{ product.title | default: "Honey Trap" }}</span>
    </nav>
    <div class="flex items-center gap-space-xs flex-wrap">
      {% if section.settings.show_concentration_badge %}
        <span class="px-space-sm py-space-2xs rounded-full font-label-caps text-[10px] bg-primary-fixed/40 text-on-primary-container border border-primary/20 font-semibold">
          {{ section.settings.concentration_badge_text | default: "Extrait De Parfum (35% Oil Concentration)" }}
        </span>
      {% endif %}
      {% if section.settings.show_awards_pill %}
        <span class="px-space-sm py-space-2xs rounded-full font-label-caps text-[10px] bg-secondary-fixed/50 text-secondary border border-secondary/20 font-semibold">
          {{ section.settings.awards_pill_text | default: "Gourmand Perfume of the Year 2025" }}
        </span>
      {% endif %}
    </div>
  </div>

  <!-- Main PDP Grid Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start">
    <!-- Left Column: Visual Showcase & Olfactory Notes Gallery -->
    <div class="lg:col-span-7 flex flex-col gap-space-md sticky top-28">
      <div class="relative bg-surface-container-lowest rounded-xl p-space-lg sm:p-space-xl border border-outline-variant/40 shadow-sm flex flex-col items-center justify-center overflow-hidden min-h-[440px]">
        <div class="absolute top-space-md left-space-md flex flex-col gap-space-2xs z-10">
          <span class="bg-primary text-on-primary font-label-caps text-[10px] px-space-sm py-1 rounded-full uppercase tracking-widest shadow-sm font-semibold">
            Artisanal Masterpiece
          </span>
          {% if section.settings.show_sillage_meter %}
            <span class="bg-secondary-container text-on-secondary-container font-label-caps text-[10px] px-space-sm py-1 rounded-full border border-secondary/20 font-semibold">
              12+ Hours Sillage
            </span>
          {% endif %}
        </div>
        <div class="absolute top-space-md right-space-md">
          <button type="button" class="w-9 h-9 rounded-full bg-surface-container-low border border-outline-variant/50 flex items-center justify-center text-outline hover:text-secondary hover:bg-surface-bright transition-all shadow-xs" title="Save to Fragrance Wardrobe">
            <span class="material-symbols-outlined text-[20px]">favorite</span>
          </button>
        </div>

        {% liquid
          assign main_image_url = "https://lh3.googleusercontent.com/aida-public/AB6AXuCYapaf1GXJUtrfPx2QOZHfNYaPSVhf38bD8toHMqtN7akXWYrdemQ-d-9U5b0Pemapq_yIEL1LI8aI1LjT2qCULxoGlwU4K9e0sSfiSKcpW31UQ0PJpc2oaqndxLUPZ9dqoJZJVlPH2nrxqQRE_Qmrht_AaBuyGa-7u_DlkWVqIOeb9e3sX6Sp5uJW2afLRAm2DTYG3Nm0OoNTIMeLcz4I2rGMVQp4J8iAmIToor1VaW3jFq8aRVKdIkcgPr4rv8q8858"
          if product.featured_image != blank
            assign main_image_url = product.featured_image | image_url: width: 900
          endif
        %}

        <img 
          alt="{{ product.title | default: 'Perfume Flacon' }}" 
          class="max-h-[380px] max-w-full object-contain transition-all duration-300 drop-shadow-[0_15px_25px_rgba(132,84,0,0.18)]" 
          id="main-product-image" 
          src="{{ main_image_url }}"
        />
        
        <!-- Fragrance Impression Quote -->
        <div class="w-full mt-space-md bg-surface-container-low/90 border border-outline-variant/50 rounded-full py-space-xs px-space-md flex items-center justify-center gap-space-xs text-secondary text-center shadow-xs">
          <span class="material-symbols-outlined text-[18px] text-primary" style="font-variation-settings: 'FILL' 1;">local_fire_department</span>
          <span class="font-label-sm tracking-normal font-medium text-on-surface-variant italic">"An intoxicating, decadent symphony of warm honey, melted spiced chocolate &amp; velvet orange blossom."</span>
        </div>
      </div>

      <!-- Thumbnail Carousel / Image Gallery -->
      <div class="grid grid-cols-4 gap-space-sm">
        {% if product.images.size > 1 %}
          {% for img in product.images limit: 4 %}
            <button type="button" class="thumb-btn bg-surface-container-lowest rounded-lg p-space-2xs border {% if forloop.first %}border-2 border-primary{% else %}border-outline-variant/40{% endif %} shadow-sm transition-all flex flex-col items-center justify-center" onclick="switchImage({{ forloop.index0 }}, '{{ img | image_url: width: 900 }}')">
              <img alt="{{ img.alt | default: product.title }}" class="h-16 w-auto object-contain" src="{{ img | image_url: width: 200 }}"/>
              <span class="font-label-caps text-[9px] text-on-surface-variant mt-1 font-semibold truncate max-w-[60px]">View {{ forloop.index }}</span>
            </button>
          {% endfor %}
        {% else %}
          <button type="button" class="thumb-btn bg-surface-container-lowest rounded-lg p-space-2xs border-2 border-primary shadow-sm transition-all flex flex-col items-center" onclick="switchImage(0, 'https://lh3.googleusercontent.com/aida-public/AB6AXuCYapaf1GXJUtrfPx2QOZHfNYaPSVhf38bD8toHMqtN7akXWYrdemQ-d-9U5b0Pemapq_yIEL1LI8aI1LjT2qCULxoGlwU4K9e0sSfiSKcpW31UQ0PJpc2oaqndxLUPZ9dqoJZJVlPH2nrxqQRE_Qmrht_AaBuyGa-7u_DlkWVqIOeb9e3sX6Sp5uJW2afLRAm2DTYG3Nm0OoNTIMeLcz4I2rGMVQp4J8iAmIToor1VaW3jFq8aRVKdIkcgPr4rv8q8858')">
            <img alt="Bottle View" class="h-16 w-auto object-contain" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDUpHpmddYhhoFppXue_9AEqBMKLegRN4jRVscKsx_xa0m8RTt2aHqaOxs2TMD4t1UQg2n8u9V859bhVou3rtigiNEoIbTFXUSVOUOcrTBx28pBRAnLZgSGzDgJK5knK2yVodqY9VQ3Yu9SDlcCQGO6Ub7w1iBY1bF_WnSWyEd1muI8jtHnyBh5V4X6e-GIqHaXxO-RDhOcak2nkqa7JhygOsZ88im4Sd6Nz_1ILw_26gzXmmx9BSdQfZtMlfJw1mtpAFY"/>
            <span class="font-label-caps text-[9px] text-primary mt-1 font-semibold">The Flacon</span>
          </button>
          <div class="bg-surface-container-lowest rounded-lg p-space-2xs border border-outline-variant/40 shadow-xs flex flex-col items-center justify-center text-center group cursor-pointer hover:border-primary transition-all">
            <span class="material-symbols-outlined text-primary text-[24px]">hive</span>
            <span class="font-label-caps text-[9px] text-on-surface-variant group-hover:text-primary mt-1 font-semibold">Honeycomb</span>
          </div>
          <div class="bg-surface-container-lowest rounded-lg p-space-2xs border border-outline-variant/40 shadow-xs flex flex-col items-center justify-center text-center group cursor-pointer hover:border-primary transition-all">
            <span class="material-symbols-outlined text-secondary text-[24px]">cookie</span>
            <span class="font-label-caps text-[9px] text-on-surface-variant group-hover:text-secondary mt-1 font-semibold">Spiced Truffle</span>
          </div>
          <div class="bg-surface-container-lowest rounded-lg p-space-2xs border border-outline-variant/40 shadow-xs flex flex-col items-center justify-center text-center group cursor-pointer hover:border-primary transition-all">
            <span class="material-symbols-outlined text-primary-container text-[24px]">water_drop</span>
            <span class="font-label-caps text-[9px] text-on-surface-variant group-hover:text-primary-container mt-1 font-semibold">Pure Extrait</span>
          </div>
        {% endif %}
      </div>

      <!-- Olfactory Performance Stats Bar -->
      <div class="bg-surface-container-low border border-outline-variant/40 rounded-xl p-space-md flex items-center justify-around text-center mt-space-xs">
        <div class="flex flex-col items-center">
          <span class="font-serif font-bold text-primary text-base">12+ Hours</span>
          <span class="font-label-caps text-[10px] text-on-surface-variant uppercase">Longevity</span>
        </div>
        <div class="h-8 w-px bg-outline-variant/40"></div>
        <div class="flex flex-col items-center">
          <span class="font-serif font-bold text-primary text-base">Intense 6ft</span>
          <span class="font-label-caps text-[10px] text-on-surface-variant uppercase">Sillage &amp; Projection</span>
        </div>
        <div class="h-8 w-px bg-outline-variant/40"></div>
        <div class="flex flex-col items-center">
          <span class="font-serif font-bold text-secondary text-base">35% Concentration</span>
          <span class="font-label-caps text-[10px] text-on-surface-variant uppercase">French Fragrance Oils</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Product Intelligence, Purchase & Routine Stack -->
    <div class="lg:col-span-5 flex flex-col gap-space-lg">
      <!-- Title & Rating Summary -->
      <div class="bg-surface-container-lowest rounded-xl p-space-lg border border-outline-variant/40 shadow-sm flex flex-col gap-space-xs">
        <span class="font-label-caps text-[11px] text-secondary tracking-[0.2em] uppercase font-semibold">Scents 'N Stories • Haute Perfumery</span>
        <h1 class="font-serif text-3xl sm:text-4xl text-on-surface font-bold tracking-tight mt-1">{{ product.title | default: "Honey Trap" }}</h1>
        <div class="font-body-md text-on-surface-variant leading-relaxed text-xs sm:text-sm">
          {% if product.description != blank %}
            {{ product.description | truncatewords: 35 }}
          {% else %}
            An enchanting gourmand floral fragrance featuring succulent golden honey, delicate orange blossom, sweet caramel chocolate truffle, and warm spiced Ceylon cinnamon. Long-lasting luxury sillage.
          {% endif %}
        </div>

        <div class="flex items-center gap-space-xs mt-space-xs flex-wrap">
          <div class="flex items-center text-primary-container">
            {% for i in (1..5) %}
              <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">star</span>
            {% endfor %}
          </div>
          <span class="font-label-sm font-bold text-on-surface ml-space-2xs">4.9</span>
          <a class="font-label-sm text-primary underline underline-offset-4 decoration-primary/40 hover:text-primary-container" href="#reviews-section">1,450+ Verified Reviews</a>
          <span class="text-outline text-[12px]">•</span>
          <span class="font-label-caps text-[10px] text-secondary uppercase font-semibold tracking-wider">Top Rated Unisex</span>
        </div>

        <!-- Pricing Display -->
        <div class="mt-space-sm pt-space-xs border-t border-outline-variant/30 flex items-baseline gap-space-xs">
          <span class="font-serif text-primary font-bold text-3xl sm:text-4xl" id="active-price-text">
            {{ product.selected_or_first_available_variant.price | default: 245000 | money }}
          </span>
          {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
            <span class="font-serif text-outline line-through text-lg" id="active-compare-price">
              {{ product.selected_or_first_available_variant.compare_at_price | money }}
            </span>
          {% endif %}
          <span class="font-serif text-on-surface-variant text-sm" id="active-vol-text">
            {% if product.selected_or_first_available_variant.title != 'Default Title' %}
              - {{ product.selected_or_first_available_variant.title }}
            {% else %}
              - 50ml Eau De Parfum
            {% endif %}
          </span>
        </div>
        <div class="flex items-center gap-space-2xs text-outline text-xs">
          <span class="material-symbols-outlined text-[15px] text-secondary">verified</span>
          <span>Tax inclusive. Handcrafted &amp; aged for optimal olfactory depth.</span>
        </div>
      </div>

      {% if section.settings.show_sensory_profile %}
        <!-- Fragrance Highlights & Sensory Profile -->
        <div class="bg-surface-container-lowest rounded-xl p-space-lg border border-outline-variant/40 shadow-sm flex flex-col gap-space-sm">
          <p class="font-headline-sm text-primary font-serif text-base sm:text-lg leading-snug">
            {{ section.settings.sensory_headline | default: "A hypnotic signature crafted to captivate the senses with warm gourmand euphoria." }}
          </p>
          <div class="space-y-space-xs mt-space-2xs">
            <div class="flex items-center gap-space-xs text-on-surface">
              <span class="material-symbols-outlined text-secondary text-[20px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
              <span class="font-body-md text-xs sm:text-sm">{{ section.settings.bullet_1 | default: "Opens with fresh neroli floral nectar & pure organic honeycomb" }}</span>
            </div>
            <div class="flex items-center gap-space-xs text-on-surface">
              <span class="material-symbols-outlined text-secondary text-[20px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
              <span class="font-body-md text-xs sm:text-sm">{{ section.settings.bullet_2 | default: "Decadent heart of toasted almonds, velvety chocolate truffle & spice" }}</span>
            </div>
            <div class="flex items-center gap-space-xs text-on-surface">
              <span class="material-symbols-outlined text-secondary text-[20px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
              <span class="font-body-md text-xs sm:text-sm">{{ section.settings.bullet_3 | default: "Rich, lingering dry-down of golden amber resin & Madagascar vanilla" }}</span>
            </div>
          </div>
        </div>
      {% endif %}

      <!-- Real Shopify Product Form & Dynamic Variant Selectors -->
      {% form 'product', product, id: 'main-product-form', class: 'flex flex-col gap-space-md' %}
        <input type="hidden" name="id" id="selected-variant-id" value="{{ product.selected_or_first_available_variant.id }}">

        {% if product.options_with_values.size > 0 and product.has_only_default_variant == false %}
          <div class="bg-surface-container-lowest rounded-xl p-space-lg border border-outline-variant/40 shadow-sm flex flex-col gap-space-md">
            {% for option in product.options_with_values %}
              <div class="flex flex-col gap-space-xs">
                <div class="flex items-center justify-between">
                  <span class="font-label-caps text-xs uppercase tracking-wider text-on-surface font-semibold">Select {{ option.name }}:</span>
                  <span class="text-xs text-primary font-bold" id="selected-opt-val-{{ forloop.index0 }}">{{ option.selected_value }}</span>
                </div>
                <div class="flex flex-wrap gap-space-xs">
                  {% for value in option.values %}
                    <button 
                      type="button" 
                      class="option-pill px-space-md py-space-xs rounded-lg border text-xs font-semibold transition-all shadow-xs {% if option.selected_value == value %}border-2 border-primary bg-primary/10 text-primary font-bold shadow-sm{% else %}border-outline-variant/50 bg-surface-container-low text-on-surface hover:border-primary{% endif %}"
                      onclick="selectOption({{ forloop.parentloop.index0 }}, '{{ value | escape }}', this)"
                    >
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <!-- Presentation Size Cards Fallback for Fragrances -->
          <div class="bg-surface-container-lowest rounded-xl p-space-lg border border-outline-variant/40 shadow-sm flex flex-col gap-space-sm">
            <div class="flex items-center justify-between">
              <span class="font-label-caps text-xs uppercase tracking-wider text-on-surface font-semibold">Select Presentation:</span>
              <a href="#panel-how-to-use" class="font-label-sm text-primary cursor-pointer hover:underline text-xs">Flacon &amp; Sillage Guide</a>
            </div>
            <div class="grid grid-cols-3 gap-space-xs sm:gap-space-sm">
              <div class="size-card cursor-pointer rounded-lg p-space-sm bg-surface-container-low border-2 border-primary transition-all duration-200 flex flex-col justify-between relative shadow-xs" onclick="selectSizePreset('50ml EDP', 'Rs. 2,450', this)">
                <div class="flex items-center justify-between w-full mb-space-xs">
                  <span class="radio-indicator w-4 h-4 rounded-full bg-primary flex items-center justify-center">
                    <span class="w-1.5 h-1.5 bg-on-primary rounded-full"></span>
                  </span>
                  <span class="font-label-caps text-[9px] text-primary font-bold uppercase">Signature</span>
                </div>
                <div>
                  <div class="font-serif text-on-surface text-sm font-semibold">50ml</div>
                  <div class="font-serif text-primary mt-0.5 text-xs font-bold">Rs. 2,450</div>
                </div>
              </div>

              <div class="size-card cursor-pointer rounded-lg p-space-sm bg-surface-container-lowest border border-outline-variant/50 hover:bg-surface-container-low transition-all duration-200 flex flex-col justify-between relative shadow-xs" onclick="selectSizePreset('100ml Flacon', 'Rs. 3,950', this)">
                <div class="absolute -top-2.5 right-1.5 bg-secondary text-on-secondary text-[9px] font-semibold px-2 py-0.5 rounded-full uppercase tracking-wider">
                  15% Off
                </div>
                <div class="flex items-center justify-between w-full mb-space-xs">
                  <span class="radio-indicator w-4 h-4 rounded-full bg-surface-container-highest flex items-center justify-center"></span>
                  <span class="font-label-caps text-[9px] text-secondary font-bold uppercase">Grand</span>
                </div>
                <div>
                  <div class="font-serif text-on-surface text-sm font-semibold">100ml</div>
                  <div class="flex flex-col mt-0.5">
                    <span class="font-serif text-primary text-xs font-bold">Rs. 3,950</span>
                    <span class="text-[10px] line-through text-outline">Rs. 4,650</span>
                  </div>
                </div>
              </div>

              <div class="size-card cursor-pointer rounded-lg p-space-sm bg-surface-container-lowest border border-outline-variant/50 hover:bg-surface-container-low transition-all duration-200 flex flex-col justify-between relative shadow-xs" onclick="selectSizePreset('10ml Pocket', 'Rs. 850', this)">
                <div class="flex items-center justify-between w-full mb-space-xs">
                  <span class="radio-indicator w-4 h-4 rounded-full bg-surface-container-highest flex items-center justify-center"></span>
                  <span class="font-label-caps text-[9px] text-on-surface-variant font-bold uppercase">Pocket</span>
                </div>
                <div>
                  <div class="font-serif text-on-surface text-sm font-semibold">10ml</div>
                  <div class="font-serif text-primary mt-0.5 text-xs font-bold">Rs. 850</div>
                </div>
              </div>
            </div>
          </div>
        {% endif %}

        <!-- Quantity Stepper & Add to Bag -->
        <div class="bg-surface-container-lowest rounded-xl p-space-lg border border-outline-variant/40 shadow-sm flex flex-col gap-space-md">
          <div class="flex items-center justify-between">
            <span class="font-label-caps text-xs uppercase font-semibold text-on-surface">Quantity:</span>
            <div class="flex items-center border border-outline-variant/60 rounded-full overflow-hidden bg-surface-container-low shadow-inner">
              <button type="button" onclick="decrementQuantity()" class="w-9 h-9 flex items-center justify-center hover:bg-surface-container text-on-surface font-bold text-sm select-none transition-colors">-</button>
              <input type="number" name="quantity" id="product-quantity-input" value="1" min="1" class="w-12 text-center bg-transparent text-xs font-bold focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none">
              <button type="button" onclick="incrementQuantity()" class="w-9 h-9 flex items-center justify-center hover:bg-surface-container text-on-surface font-bold text-sm select-none transition-colors">+</button>
            </div>
          </div>

          <button 
            type="submit" 
            name="add" 
            class="w-full py-space-md px-space-xl rounded-full text-on-primary font-label-caps tracking-[0.18em] text-center shadow-lg hover:shadow-xl transition-all active:scale-[0.98] flex items-center justify-center gap-space-xs uppercase text-xs sm:text-sm font-semibold cursor-pointer" 
            id="main-atc-button" 
            style="background: linear-gradient(90deg, #845400 0%, #c98a2c 60%, #904c21 100%);"
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
          >
            <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
            <span id="atc-btn-text">
              {% if product.selected_or_first_available_variant.available %}
                Add To Cart &bull; <span id="cta-price-display">{{ product.selected_or_first_available_variant.price | default: 245000 | money }}</span>
              {% else %}
                Sold Out
              {% endif %}
            </span>
          </button>

          <!-- Accelerated Checkout Buy Now -->
          <div class="w-full">
            {{ form | payment_button }}
          </div>

          <div class="flex items-center justify-center gap-space-xs text-on-surface-variant font-body-md text-xs py-space-2xs flex-wrap">
            <span class="material-symbols-outlined text-[16px] text-primary">local_shipping</span>
            <span>Express 24-48 hr Dispatch Nationwide</span>
            <span>•</span>
            <span class="text-secondary font-semibold">Free Delivery Above Rs. 1,500</span>
          </div>
        </div>
      {% endform %}

      {% if section.settings.show_trust_badges %}
        <!-- Artisanal Fragrance Trust Badges Row -->
        <div class="bg-surface-container-lowest rounded-xl p-space-md border border-outline-variant/40 shadow-sm">
          <div class="grid grid-cols-4 gap-space-xs text-center">
            <div class="flex flex-col items-center gap-space-2xs">
              <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-surface-container flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[20px] sm:text-[22px]">schedule</span>
              </div>
              <span class="font-label-caps text-[9px] sm:text-[10px] text-on-surface leading-tight font-medium">12+ Hrs<br/>Longevity</span>
            </div>
            <div class="flex flex-col items-center gap-space-2xs">
              <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-surface-container flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[20px] sm:text-[22px]">cruelty_free</span>
              </div>
              <span class="font-label-caps text-[9px] sm:text-[10px] text-on-surface leading-tight font-medium">Cruelty-Free<br/>&amp; Vegan</span>
            </div>
            <div class="flex flex-col items-center gap-space-2xs">
              <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-surface-container flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[20px] sm:text-[22px]">water_drop</span>
              </div>
              <span class="font-label-caps text-[9px] sm:text-[10px] text-on-surface leading-tight font-medium">French Pure<br/>Oils (35%)</span>
            </div>
            <div class="flex flex-col items-center gap-space-2xs">
              <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-surface-container flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[20px] sm:text-[22px]">palette</span>
              </div>
              <span class="font-label-caps text-[9px] sm:text-[10px] text-on-surface leading-tight font-medium">Artisanal<br/>Handcrafted</span>
            </div>
          </div>
        </div>
      {% endif %}

      {% if section.settings.show_routine_bundle %}
        <!-- COMPLETE YOUR ROUTINE / COLLECTION BUNDLE MODULE -->
        <div class="bg-surface-container-lowest rounded-xl p-space-lg border border-outline-variant/40 shadow-md flex flex-col gap-space-md">
          <div class="flex items-center justify-between">
