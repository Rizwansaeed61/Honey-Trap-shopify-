<!-- Product Interactive Scripts -->
<script>
  var productVariants = {{ product.variants | json }};
  var selectedOptions = {};

  {% for option in product.options_with_values %}
    selectedOptions[{{ forloop.index0 }}] = {{ option.selected_value | json }};
  {% endfor %}

  function selectOption(optionIndex, value, btnEl) {
    selectedOptions[optionIndex] = value;
    
    // Update pill styles in group
    var parent = btnEl.parentElement;
    parent.querySelectorAll('.option-pill').forEach(function(pill) {
      pill.className = "option-pill px-space-md py-space-xs rounded-lg border text-xs font-semibold transition-all shadow-xs border-outline-variant/50 bg-surface-container-low text-on-surface hover:border-primary";
    });
    btnEl.className = "option-pill px-space-md py-space-xs rounded-lg border text-xs font-semibold transition-all shadow-xs border-2 border-primary bg-primary/10 text-primary font-bold shadow-sm";

    var label = document.getElementById('selected-opt-val-' + optionIndex);
    if (label) label.textContent = value;

    // Find matching variant
    if (productVariants && productVariants.length) {
      var matched = productVariants.find(function(v) {
        return Object.keys(selectedOptions).every(function(idx) {
          return v.options[idx] === selectedOptions[idx];
        });
      });

      if (matched) {
        var hiddenInput = document.getElementById('selected-variant-id');
        if (hiddenInput) hiddenInput.value = matched.id;

        var priceFormatted = (matched.price / 100).toLocaleString('en-PK', { style: 'currency', currency: 'PKR', maximumFractionDigits: 0 }).replace('PKR', 'Rs.');
        var priceEl = document.getElementById('active-price-text');
        if (priceEl) priceEl.textContent = priceFormatted;

        var ctaPrice = document.getElementById('cta-price-display');
        if (ctaPrice) ctaPrice.textContent = priceFormatted;

        var volText = document.getElementById('active-vol-text');
        if (volText) volText.textContent = '- ' + matched.title;

        var atcBtn = document.getElementById('main-atc-button');
        if (atcBtn) {
          if (matched.available) {
            atcBtn.removeAttribute('disabled');
            document.getElementById('atc-btn-text').innerHTML = 'Add To Cart &bull; <span id="cta-price-display">' + priceFormatted + '</span>';
          } else {
            atcBtn.setAttribute('disabled', 'disabled');
            document.getElementById('atc-btn-text').textContent = 'Sold Out';
          }
        }
      }
    }
  }

  function selectSizePreset(name, priceStr, el) {
    document.querySelectorAll('.size-card').forEach(function(c) {
      c.className = "size-card cursor-pointer rounded-lg p-space-sm bg-surface-container-lowest border border-outline-variant/50 hover:bg-surface-container-low transition-all duration-200 flex flex-col justify-between relative shadow-xs";
      var ind = c.querySelector('.radio-indicator');
      if (ind) {
        ind.className = "radio-indicator w-4 h-4 rounded-full bg-surface-container-highest flex items-center justify-center";
        ind.innerHTML = '';
      }
    });
    el.className = "size-card cursor-pointer rounded-lg p-space-sm bg-surface-container-low border-2 border-primary transition-all duration-200 flex flex-col justify-between relative shadow-xs";
    var ind = el.querySelector('.radio-indicator');
    if (ind) {
      ind.className = "radio-indicator w-4 h-4 rounded-full bg-primary flex items-center justify-center";
      ind.innerHTML = '<span class="w-1.5 h-1.5 bg-on-primary rounded-full"></span>';
    }

    var priceEl = document.getElementById('active-price-text');
    if (priceEl) priceEl.textContent = priceStr;
    var ctaPrice = document.getElementById('cta-price-display');
    if (ctaPrice) ctaPrice.textContent = priceStr;
    var volText = document.getElementById('active-vol-text');
    if (volText) volText.textContent = '- ' + name;
  }

  function incrementQuantity() {
    var input = document.getElementById('product-quantity-input');
    if (input) input.value = parseInt(input.value || 1) + 1;
  }

  function decrementQuantity() {
    var input = document.getElementById('product-quantity-input');
    if (input && parseInt(input.value) > 1) {
      input.value = parseInt(input.value) - 1;
    }
  }

  function switchImage(index, url) {
    var img = document.getElementById('main-product-image');
    if (img) img.src = url;
    document.querySelectorAll('.thumb-btn').forEach(function(btn, i) {
      if (i === index) {
        btn.classList.add('border-2', 'border-primary');
        btn.classList.remove('border-outline-variant/40');
      } else {
        btn.classList.remove('border-2', 'border-primary');
        btn.classList.add('border-outline-variant/40');
      }
    });
  }

  function switchTab(tabId) {
    document.querySelectorAll('.tab-panel').forEach(function(panel) {
      panel.classList.add('hidden');
    });
    var activePanel = document.getElementById('panel-' + tabId);
    if (activePanel) activePanel.classList.remove('hidden');

    ['ingredients', 'how-to-use', 'clinical-data'].forEach(function(id) {
      var btn = document.getElementById('tab-btn-' + id);
      if (btn) {
        var ind = btn.querySelector('.tab-indicator');
        if (id === tabId) {
          btn.classList.add('text-primary', 'font-bold');
          btn.classList.remove('text-on-surface-variant');
          if (ind) ind.className = "tab-indicator absolute bottom-0 left-0 w-full h-0.5 bg-primary";
        } else {
          btn.classList.remove('text-primary', 'font-bold');
          btn.classList.add('text-on-surface-variant');
          if (ind) ind.className = "tab-indicator absolute bottom-0 left-0 w-full h-0.5 bg-transparent";
        }
      }
    });
  }

  function updateRoutineTotal() {
    var total = 2450;
    var count = 1;
    var s2 = document.getElementById('routine-step-2');
    var s3 = document.getElementById('routine-step-3');
    if (s2 && s2.checked) { total += {{ section.settings.routine_item_2_price | default: 1150 }}; count++; }
    if (s3 && s3.checked) { total += {{ section.settings.routine_item_3_price | default: 1350 }}; count++; }
    
    var priceEl = document.getElementById('routine-total-price');
    if (priceEl) priceEl.textContent = 'Rs. ' + total.toLocaleString();
    var countEl = document.getElementById('routine-count-label');
    if (countEl) countEl.textContent = 'Add ' + count + ' Routine Items To Bag';
  }

  function addRoutineToCart() {
    var toast = document.createElement('div');
    toast.className = 'fixed bottom-6 right-6 bg-primary text-on-primary px-6 py-3 rounded-full shadow-2xl z-50 flex items-center gap-2 text-xs font-semibold';
    toast.innerHTML = '<span class="material-symbols-outlined text-[18px]">verified</span> Complete Routine Added to Your Wardrobe!';
    document.body.appendChild(toast);
    setTimeout(function() { toast.remove(); }, 3500);
    if (window.LuxuryCart && typeof window.LuxuryCart.openDrawer === 'function') {
      window.LuxuryCart.openDrawer();
    }
  }
</script>

